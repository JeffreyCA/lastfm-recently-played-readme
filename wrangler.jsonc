{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lastfm-recently-played",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  // Workers Cache sits in front of the Worker: cacheable responses are served
  // from the edge without running it, and concurrent misses for the same card
  // collapse into a single invocation. Unlike the legacy Cache API this is
  // zoneless, so it works on *.workers.dev too.
  "cache": {
    "enabled": true
  },
  "vars": {
    // Public, non-secret defaults. LASTFM_API_KEY is a secret, set via:
    //   npx wrangler secret put LASTFM_API_KEY
    "UPSTREAM_CACHE_SECONDS": "60",
    "ART_CACHE_SECONDS": "86400"
  }
}
